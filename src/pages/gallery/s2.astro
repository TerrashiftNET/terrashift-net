---
import "../../styles/global.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import GalleyLinks from "../../components/Gallery-Links.astro";

const images = Object.values(
  import.meta.glob<{ default: ImageMetadata }>(
    "../../assets/gallery/s2/*.png",
    { eager: true, query: "?url", import: "default" }
  )
);
---

<Layout title="Terrashift | S2 Gallery">
  <Header />
  <div class="flex flex-col items-center justify-center p-1">
    <h1>S2 Gallery</h1>
    <GalleyLinks />
    <div class="grid grid-cols-4 gap-4 mx-24 my-4">
      {
        images.map((image) => (
          <Image
            src={image}
            alt="Gallery Image"
            loading="lazy"
            width="1600"
            height="900"
            class="width-full height-full object-cover cursor-pointer transition-all duration-500 hover:scale-110:big"
            id="gallery-image"
          />
        ))
      }
    </div>
  </div>
</Layout>

<style>
  img:hover:not(.big) {
    transform: scale(1.1);
  }

  img.big {
    width: auto;
    height: 80%;
    object-fit: contain;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    margin: auto;
    z-index: 2;
    background-color: rgba(0, 0, 0, 0.8);
    transition: all 0.5s;
    animation: zoom 0.5s;
  }

  @keyframes zoom {
    from {
      transform: scale(0.5);
    }
    to {
      transform: scale(1);
    }
  }

  h1 {
    font-size: 2rem;
    margin: 1rem;
  }
</style>

<script>
  if (window.innerWidth > 320) {
    document.querySelectorAll("img").forEach((img) => {
      img.addEventListener("click", () => {
        img.classList.toggle("big");
      });
    });
  }
</script>
