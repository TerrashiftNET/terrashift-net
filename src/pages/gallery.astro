---
import "../styles/global.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import GalleyLinks from "../components/Gallery-Links.astro";

const images = Object.values(
  import.meta.glob<{ default: ImageMetadata }>(
    "../assets/gallery/current/*.png",
    {
      eager: true,
      query: "?url",
      import: "default",
    }
  )
);
---

<Layout title="Terrashift | Current Season Gallery">
  <Header />
  <div class="flex flex-col items-center justify-center p-1">
    <h1>Current Season Gallery</h1>
    <GalleyLinks />
    <div class="grid grid-cols-4 gap-4 mx-24 my-4">
      {
        images.map((image) => (
          <Image
            src={image}
            alt="Gallery Image"
            loading="lazy"
            width="1600"
            height="900"
            class="width-full height-full object-cover cursor-pointer transition-all duration-500 hover:scale-110:big"
            id="gallery-image"
          />
        ))
      }
    </div>
  </div>
</Layout>

<script>
  if (window.innerWidth > 320) {
    document.querySelectorAll("img").forEach((img) => {
      img.addEventListener("click", () => {
        img.classList.toggle("big");
      });
    });
  }
</script>
