---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SpawnImage from "../assets/terrashift-spawn.png";
import { Image } from "astro:assets";
---

<Layout title="Home | Terrashift">
    <Header />
    <main
        class="m-auto p-4 w-200 max-w-200 text-[#cdd6f4] text-lg/10 md:text-xl/10"
    >
        <Image
            id="spawn-image"
            alt="Terrashift spawn"
            src={SpawnImage}
            loading="eager"
            class="width-full max-w-75 md:max-w-125 block m-auto rounded-xl h-auto p-5"
        />
        <p class="text-center px-2.5">
            Terrashift is a whitelisted vanilla Minecraft server with
            collaboration and community focus.
        </p>
        <p class="text-center px-2.5">
            With many friendly, experienced and knowledgeable members we are a
            great place to hangout at whether you prefer building giant redstone
            contraptions or just cozy huts to relax.
        </p>
        <p class="text-center px-2.5">
            More details can be found on the top right menu. To apply for
            membership use the "Apply" link in the same menu.
        </p>
    </main>
</Layout>
